// ### RIGHT PANEL - DankMaterialShell look ### //
// Pair with style/Dank-Material.css

{
"include": [
  "$HOME/.config/hypr/waybar/Modules",
  "$HOME/.config/hypr/waybar/ModulesWorkspaces",
  "$HOME/.config/hypr/waybar/ModulesCustom",
  "$HOME/.config/hypr/waybar/ModulesGroups",
  "$HOME/.config/hypr/waybar/UserModules",
  "$HOME/.config/hypr/waybar/ModulesVertical",
  ],
"layer": "top",
"position": "right",
"margin-top": 8,
"margin-bottom": 8,
"margin-right": 1,
"spacing": 6,
"fixed-center": true,
"ipc": true,

"modules-left": [
	"custom/menu#dank",
	"hyprland/workspaces#dank",
	"hyprland/submap",
],

"modules-center": [
	"clock#dank",
],

"modules-right": [
	// "mpris" disabled: playerctld crash-loop hides the entire bar (see RIGHT-EastWing)
	"tray",
	"group/dank-controls",
	"group/dank-notify",
	"custom/power_vertical",
],

// Workspaces as pills: dots, active one stretched tall
"hyprland/workspaces#dank": {
	"active-only": false,
	"all-outputs": true,
	"format": "",
	"show-special": false,
	"on-click": "activate",
	"on-scroll-up": "hyprctl dispatch workspace e+1",
	"on-scroll-down": "hyprctl dispatch workspace e-1",
	"persistent-workspaces": {
		"*": 5
	},
},

// Stacked hour / minute
"clock#dank": {
	"format": "{:%H\n%M}",
	"interval": 10,
	"tooltip": true,
	"tooltip-format": "<big>{:%A, %d %B %Y}</big>\n\n{calendar}",
	"calendar": {
		"mode": "month",
		"format": {
			"today": "<span color='#0dbc79'><b>{}</b></span>",
		}
	}
},

// Control-center style pill: all quick toggles in one group
"group/dank-controls": {
	"orientation": "inherit",
	"modules": [
		"custom/hypr_layout",
		"custom/light_dark",
		"idle_inhibitor",
		"custom/nightlight",
		"backlight#vertical",
		"pulseaudio#microphone_vertical",
		"pulseaudio#vertical",
	]
},

// Same as the stock modules, minus the padding spaces that
// forced every island wider
"custom/menu#dank": {
	"format": "",
	"on-click": "rofi_dir=\"$HOME/.config/hypr/rofi\"; [ ! -d \"$rofi_dir\" ] && rofi_dir=\"$HOME/.config/rofi\"; pkill rofi || true; $HOME/.config/hypr/scripts/RofiFocusedWallpaperLink.sh >/dev/null 2>&1 || true; rofi -show drun -modi run,drun,filebrowser,window -config \"$rofi_dir/config.rasi\"",
	"on-click-middle": "$HOME/.config/hypr/UserScripts/WallpaperSelect.sh",
	"on-click-right": "$HOME/.config/hypr/scripts/WaybarLayout.sh",
	"tooltip": true,
	"tooltip-format": "Left Click: Rofi Menu\nMiddle Click: Wallpaper Menu\nRight Click: Waybar Layout Menu",
},

"group/dank-notify": {
	"orientation": "inherit",
	"drawer": {
		"transition-duration": 500,
		"children-class": "custom/swaync",
		"transition-left-to-right": false
	},
	"modules": [
		"custom/swaync#dank",
		"custom/dot_update#dank",
	]
},
"custom/swaync#dank": {
	"tooltip": true,
	"tooltip-format": "Left Click: Launch Notification Center\nRight Click: Do not Disturb",
	"format": "{icon}",
	"format-icons": {
		"notification": "<span foreground='red'><sup></sup></span>",
		"none": "",
		"dnd-notification": "<span foreground='red'><sup></sup></span>",
		"dnd-none": "",
		"inhibited-notification": "<span foreground='red'><sup></sup></span>",
		"inhibited-none": "",
		"dnd-inhibited-notification": "<span foreground='red'><sup></sup></span>",
		"dnd-inhibited-none": ""
	},
	"return-type": "json",
	"exec-if": "which swaync-client",
	"exec": "swaync-client -swb",
	"on-click": "sleep 0.1 && swaync-client -t -sw",
	"on-click-right": "swaync-client -d -sw",
	"escape": true,
},

"custom/dot_update#dank": {
	"format": "󰁈",
	"on-click": "$HOME/.config/hypr/scripts/KooLsDotsUpdate.sh",
	"tooltip": true,
	"tooltip-format": "Check KooL Dots update\nIf available",
},

}
